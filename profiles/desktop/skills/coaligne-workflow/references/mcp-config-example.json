{
  "_comment": "MCP client configuration example for connecting to the coAligne MCP server.",
  "_comment2": "Add this to your agent's MCP server configuration (e.g. Claude Desktop, Cursor, Devin, etc.)",
  "mcpServers": {
    "coAligne": {
      "transport": "streamable-http",
      "url": "https://app.coaligne.com/mcp",
      "headers": {
        "Authorization": "Bearer ca_YOUR_ACCESS_TOKEN_HERE"
      }
    }
  },
  "_env_var_alternative": {
    "_comment": "If you cannot set headers in the MCP config, set the env var instead:",
    "env": {
      "COALIGNE_ACCESS_TOKEN": "ca_YOUR_ACCESS_TOKEN_HERE"
    }
  },
  "_tools_summary": {
    "project": [
      "list_projects",
      "me",
      "get_project_activity"
    ],
    "teams": [
      "list_teams",
      "list_team_members"
    ],
    "files": [
      "download_file",
      "list_file_comments"
    ],
    "shell": [
      "search"
    ],
    "links": [
      "resolve_file_link",
      "resolve_session_link"
    ]
  }
}
